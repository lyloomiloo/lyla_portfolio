---
---

<nav class="taskbar">
  <button class="taskbar-tab" data-tab="home">
    <span class="taskbar-play">▶</span> home.exe
  </button>
  <div class="taskbar-divider"></div>
  <button class="taskbar-tab" data-tab="projects">projects.exe</button>
  <button class="taskbar-tab" data-tab="about">about.exe</button>
  <button class="taskbar-tab" data-tab="skills">capabilities.dll</button>
  <button class="taskbar-tab" data-tab="contact">contact.txt</button>
  <div class="taskbar-spacer"></div>
  <div class="taskbar-clock" data-taskbar-clock></div>
  <button class="music-toggle" id="musicToggle" aria-label="Play Christmas music" title="Play Christmas music" aria-pressed="false"><span class="mt-note">&#9834;</span></button>
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle the Draft Yard" title="Toggle the Draft Yard">
    <span class="tt-moon"></span>
    <span class="tt-sun"></span>
    <span class="tt-flake"></span>
  </button>
  <div class="taskbar-divider"></div>
  <button class="taskbar-tab taskbar-logoff" id="logoffBtn">&#9211; Log Off</button>
</nav>

<script>
  const clock = document.querySelector('[data-taskbar-clock]');
  function updateClock() {
    if (!clock) return;
    const now = new Date();
    clock.textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
  }
  updateClock();
  setInterval(updateClock, 30000);
</script>

<script>
  // Seasonal chiptune — a soft 8-bit "Jingle Bells" (melody is public domain, 1857),
  // synthesised live with the Web Audio API (same toolkit as the duck quack + game sfx).
  // No audio files, no autoplay: it only starts on a click, and only shows in Xmas season.
  (function () {
    const btn = document.getElementById('musicToggle');
    if (!btn) return;

    const F = {
      B3: 246.94,
      C4: 261.63, D4: 293.66, E4: 329.63, F4: 349.23, G4: 392.0, A4: 440.0, B4: 493.88,
      C5: 523.25, D5: 587.33, R: 0,
    };
    // Each track is a public-domain carol melody as [note, beats] pairs (quarter note = 1 beat,
    // R = rest). They play as a medley: one carol, a short breath, then the next, looping round.
    const TRACKS = [
      { name: 'Jingle Bells', seq: [
        ['E4',1],['E4',1],['E4',2], ['E4',1],['E4',1],['E4',2],
        ['E4',1],['G4',1],['C4',1],['D4',1],['E4',4],
        ['F4',1],['F4',1],['F4',1],['F4',1], ['F4',1],['E4',1],['E4',1],['E4',0.5],['E4',0.5],
        ['E4',1],['D4',1],['D4',1],['E4',1],['D4',2],['G4',2],
        ['E4',1],['E4',1],['E4',2], ['E4',1],['E4',1],['E4',2],
        ['E4',1],['G4',1],['C4',1],['D4',1],['E4',4],
        ['F4',1],['F4',1],['F4',1],['F4',1], ['F4',1],['E4',1],['E4',1],['E4',0.5],['E4',0.5],
        ['G4',1],['G4',1],['F4',1],['D4',1],['C4',4],
      ] },
      { name: 'Joy to the World', seq: [
        ['C5',1.5],['B4',0.5],['A4',1],['G4',3],['F4',1],['E4',1],['D4',1],['C4',3],
      ] },
      { name: 'Deck the Halls', seq: [
        ['G4',1],['F4',1],['E4',1],['D4',1], ['C4',1],['D4',1],['E4',1],['C4',1],
        ['D4',1],['E4',1],['F4',1],['E4',1], ['D4',1],['C4',1],['B3',1],['C4',2],
      ] },
      { name: 'We Wish You a Merry Christmas', seq: [
        ['C4',1], ['F4',1],['F4',1],['G4',1],['F4',1],['E4',1],['D4',2],
        ['D4',1], ['G4',1],['G4',1],['A4',1],['G4',1],['F4',1],['E4',2],
        ['E4',1], ['A4',1],['A4',1],['B4',1],['A4',1],['G4',1],['F4',2],
      ] },
      { name: 'Silent Night', seq: [
        ['G4',1.5],['A4',0.5],['G4',1],['E4',2], ['G4',1.5],['A4',0.5],['G4',1],['E4',2],
        ['D5',2],['D5',1],['B4',3], ['C5',2],['C5',1],['G4',3],
      ] },
    ];
    const GAP_BEATS = 2;      // breath between carols
    const BEAT = 0.34;        // seconds per quarter note
    const NOTE_PEAK = 0.2;    // per-note amplitude (kept low so it stays in the background)

    let ctx = null, master = null, timer = null, playing = false, voices = [], trackIdx = 0;

    function playNote(freq, start, dur) {
      if (!freq) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = freq;
      const end = start + dur;
      g.gain.setValueAtTime(0, start);
      g.gain.linearRampToValueAtTime(NOTE_PEAK, start + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0008, end);
      osc.connect(g).connect(master);
      osc.start(start);
      osc.stop(end + 0.02);
      voices.push(osc);
      osc.onended = () => { voices = voices.filter((v) => v !== osc); };
    }

    function scheduleTrack() {
      let t = ctx.currentTime + 0.08;
      for (const [n, beats] of TRACKS[trackIdx].seq) {
        const dur = beats * BEAT;
        playNote(F[n], t, dur * 0.9); // small gap between notes -> plucky, bell-like
        t += dur;
      }
      t += GAP_BEATS * BEAT; // breath before the next carol
      const nextMs = (t - ctx.currentTime) * 1000;
      timer = setTimeout(() => {
        if (!playing) return;
        trackIdx = (trackIdx + 1) % TRACKS.length; // cycle through the medley
        scheduleTrack();
      }, nextMs - 140);
    }

    function start() {
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
      if (ctx.state === 'suspended') ctx.resume();
      if (!master) { master = ctx.createGain(); master.connect(ctx.destination); }
      master.gain.cancelScheduledValues(ctx.currentTime);
      master.gain.setValueAtTime(0.0001, ctx.currentTime);
      master.gain.linearRampToValueAtTime(0.5, ctx.currentTime + 0.12);
      playing = true;
      scheduleTrack();
      btn.classList.add('is-playing');
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('title', 'Mute Christmas music');
      btn.setAttribute('aria-label', 'Mute Christmas music');
    }

    function stop() {
      playing = false;
      trackIdx = 0; // next play starts the medley from the top
      if (timer) { clearTimeout(timer); timer = null; }
      if (ctx && master) {
        master.gain.cancelScheduledValues(ctx.currentTime);
        master.gain.setValueAtTime(master.gain.value, ctx.currentTime);
        master.gain.linearRampToValueAtTime(0.0001, ctx.currentTime + 0.14);
      }
      setTimeout(() => { voices.forEach((v) => { try { v.stop(); } catch (e) {} }); voices = []; }, 180);
      btn.classList.remove('is-playing');
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('title', 'Play Christmas music');
      btn.setAttribute('aria-label', 'Play Christmas music');
    }

    const PKEY = 'xmasMusic';
    const muted = () => { try { return localStorage.getItem(PKEY) === '0'; } catch (e) { return false; } };
    const setPref = (on) => { try { localStorage.setItem(PKEY, on ? '1' : '0'); } catch (e) {} };
    const isXmasSeason = () => {
      const forced = new URLSearchParams(location.search).get('season');
      if (forced) return forced === 'xmas';
      const n = new Date(), mo = n.getMonth(), d = n.getDate();
      return mo === 10 || mo === 11 || (mo === 0 && d <= 10);
    };
    const wantAutoplay = () => isXmasSeason() && !muted();

    btn.addEventListener('click', () => {
      if (playing) { stop(); setPref(false); }
      else { start(); setPref(true); }
    });

    // Play by default. Browsers block autoplay with sound, so arm the carol to begin on
    // the first interaction anywhere on the page — the lock-screen "Log In" click counts,
    // so on a first visit it starts the moment you enter the desktop. A stored mute ('0')
    // is respected, and clicks on the music toggle itself are left to its own handler.
    if (wantAutoplay()) {
      const EVTS = ['pointerdown', 'keydown', 'touchstart'];
      const cleanup = () => EVTS.forEach((ev) => window.removeEventListener(ev, kick, true));
      function kick(e) {
        if (e && e.target && e.target.closest && e.target.closest('#musicToggle')) return;
        if (!playing && wantAutoplay()) start();
        cleanup();
      }
      EVTS.forEach((ev) => window.addEventListener(ev, kick, { capture: true }));
    }

    // Don't keep playing in a backgrounded tab.
    document.addEventListener('visibilitychange', () => { if (document.hidden && playing) stop(); });
  })();
</script>

<style is:global>
  .taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--dark);
    border-top: 2px solid var(--orange);
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    height: 38px;
  }

  .taskbar-tab {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #888;
    background: none;
    border: none;
    padding: 6px 12px;
    border-right: 1px solid #333;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .taskbar-tab:hover { background: #333; color: #ccc; }
  .taskbar-tab.active { background: rgba(255,107,0,0.15); color: var(--orange); border-bottom: 2px solid var(--orange); }

  .taskbar-play { color: var(--green); margin-right: 4px; }

  .taskbar-divider {
    width: 1px;
    height: 20px;
    background: #444;
    margin: 0 2px;
  }

  .taskbar-spacer { flex: 1; }

  .taskbar-logoff {
    color: #aaa !important;
  }
  .taskbar-logoff:hover {
    color: #FF5F57 !important;
    background: rgba(255,95,87,0.1) !important;
  }

  .taskbar-clock {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #888;
    padding: 0 10px;
  }

  /* Seasonal music toggle — only shown in the Xmas season (same scope as the Snow Yard) */
  .music-toggle {
    width: 26px; height: 20px; padding: 0; margin-right: 4px; cursor: pointer; flex: none;
    background: none; border: 1px solid #444; border-radius: 3px;
    display: none; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 0.82rem; line-height: 1; color: #9ba1ab;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  body.season-xmas .music-toggle { display: inline-flex; }
  .music-toggle:hover { border-color: var(--orange); background: rgba(255,107,0,0.12); color: var(--orange); }
  .music-toggle.is-playing { color: var(--green); border-color: var(--green); }
  .music-toggle .mt-note { display: block; }
  .music-toggle.is-playing .mt-note { animation: mt-bob 0.85s ease-in-out infinite; }
  @keyframes mt-bob { 0%, 100% { transform: translateY(1px); } 50% { transform: translateY(-2px); } }

  @media (max-width: 768px) {
    .taskbar { display: none !important; }
  }
</style>
