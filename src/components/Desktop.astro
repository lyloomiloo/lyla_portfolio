</style>

<script>
  (function () {
    const body = document.body;
    const btn = document.getElementById('themeToggle');
    const KEY = 'draftYard';
    const mobile = window.matchMedia('(max-width: 768px)');
    // Seasonal theme: the same toggle swaps the meadow for the Snow Yard (Xmas) from
    // 1 Nov to 10 Jan, and for the Draft Yard (Halloween) the rest of the year.
    // Preview either any time with ?season=xmas or ?season=halloween.
    const forced = new URLSearchParams(location.search).get('season');
    const now = new Date(), m = now.getMonth(), d = now.getDate();
    const isXmas = forced ? forced === 'xmas' : (m === 10 || m === 11 || (m === 0 && d <= 10));
    const THEME = isXmas ? 'snow-yard' : 'draft-yard';
    body.classList.toggle('season-xmas', isXmas);
    if (btn) {
      const label = isXmas ? 'Toggle the Snow Yard' : 'Toggle the Draft Yard';
      btn.setAttribute('aria-label', label); btn.setAttribute('title', label);
    }
    const wanted = () => { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
    // Seasonal modes are desktop-only — never apply them on mobile.
    const sync = () => body.classList.toggle(THEME, wanted() && !mobile.matches);
    sync();
    mobile.addEventListener('change', sync);
    if (btn) btn.addEventListener('click', () => {
      const on = !body.classList.contains(THEME);
      try { localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) {}
      sync();
    });
  })();

  // The pumpkin roams the whole meadow in 2D, the same way the desktop duck does:
  // it walks toward random waypoints, pauses now and then, and faces its heading.
  function roam(sel, bodyClass, bounce) {
    const p = document.querySelector(sel);
    if (!p) return;
    const MINX = 5, MAXX = 85, MINY = 9, MAXY = 33; // percent of the desktop
    let x = 20, y = 20, tx = 60, ty = 24, dir = 1, pause = 600, last = performance.now();
    let bPhase = 0, bH = 2.5, bPeriod = 260, bRest = 0; // irregular ball-bounce state
    const pick = () => {
      tx = MINX + Math.random() * (MAXX - MINX);
      ty = MINY + Math.random() * (MAXY - MINY);
      pause = 500 + Math.random() * 1600;
    };
    const SPEED = 0.006;
    const frame = (now) => {
      const dt = Math.min(now - last, 50); last = now;
      if (document.body.classList.contains(bodyClass)) {
        if (pause > 0) {
          pause -= dt;
          p.classList.remove('walking');
        } else {
          const dx = tx - x, dy = ty - y;
          const dist = Math.hypot(dx, dy);
          if (dist < 0.7) {
            pick();
          } else {
            x += (dx / dist) * SPEED * dt;
            y += (dy / dist) * SPEED * 0.6 * dt; // slower vertical, like the duck
            if (Math.abs(dx) > 0.1) dir = dx > 0 ? 1 : -1;
            p.classList.add('walking');
            p.style.left = x + '%';
            if (Math.random() < 0.0012) pause = 600 + Math.random() * 1400; // occasional rest
          }
        }
        // a little ball-like bounce with no fixed cadence: each hop gets its own
        // random height and speed, with the odd rest on the ground between hops.
        let by = y;
        if (bounce) {
          if (bRest > 0) {
            bRest -= dt;
          } else {
            bPhase += (dt / bPeriod) * Math.PI;
            if (bPhase >= Math.PI) {
              bPhase = 0;
              bH = 1.2 + Math.random() * 3.3;
              bPeriod = 160 + Math.random() * 300;
              bRest = Math.random() < 0.35 ? 60 + Math.random() * 520 : 0;
            }
            by = y + Math.sin(bPhase) * bH;
          }
        }
        p.style.bottom = by + '%';
        p.style.transform = 'scaleX(' + dir + ')';
      }
      requestAnimationFrame(frame);
    };
    pick();
    requestAnimationFrame(frame);
  }
  roam('.yard-pumpkin', 'draft-yard');
  roam('.yard-snowman', 'snow-yard', true);
</script>
