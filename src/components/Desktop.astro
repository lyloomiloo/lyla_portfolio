  body.snow-yard .yard-snowman:hover { filter: drop-shadow(0 2px 0 rgba(60,80,130,0.35)) drop-shadow(0 0 12px rgba(255,214,120,0.95)); }

  /* ========== DESKTOP PET DUCK ========== */
  .duck {
    position: absolute;
