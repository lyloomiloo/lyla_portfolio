---
import DesktopIcon from './DesktopIcon.astro';
import { icons, colorMap } from '../data/pixel-icons';
const duckGrid = icons['duck'];

// Pixel pumpkin king for the Draft Yard dark mode
// Y=crown/collar, O=orange pumpkin + belt, K=cut-outs/hands/legs, P=royal cloak
// A tiny two-circle pumpkin that wanders the yard like the duck.
// Y=crown, O=pumpkin, K=face. Head circle over a body circle.
const pumpkinKing = [
  ['_','_','_','Y','_','Y','_','_','_'],
  ['_','_','O','O','O','O','O','_','_'],
  ['_','O','O','O','O','O','O','O','_'],
  ['_','O','O','K','O','K','O','O','_'],
  ['_','O','O','O','O','O','O','O','_'],
  ['_','_','O','K','K','K','O','_','_'],
  ['_','_','O','O','O','O','O','_','_'],
  ['K','O','O','O','O','O','O','O','K'],
  ['O','O','O','O','O','O','O','O','O'],
  ['O','O','O','O','O','O','O','O','O'],
  ['_','O','O','O','O','O','O','O','_'],
  ['_','_','O','O','O','O','O','_','_'],
  ['_','_','K','K','_','K','K','_','_'],
];
---

<div class="desktop">
  <!-- Pixel landscape layers -->
  <div class="landscape">
    <!-- Sky -->
    <div class="sky"></div>
    <!-- Clouds (pixel blocks) -->
    <div class="cloud cloud-1"></div>
    <div class="cloud cloud-2"></div>
    <div class="cloud cloud-3"></div>
    <!-- Sun (decorative only now) -->
    <div class="pixel-sun"></div>
    <!-- Hills -->
    <div class="hill hill-far"></div>
    <div class="hill hill-mid"></div>
    <div class="hill hill-near"></div>
    <!-- Ground -->
    <div class="ground"></div>
    <!-- Pixel trees -->
    <div class="tree tree-1"></div>
    <div class="tree tree-2"></div>
    <div class="tree tree-3"></div>
    <div class="tree tree-4"></div>
    <!-- Pixel flowers scattered on ground -->
    <div class="flower f1"></div>
    <div class="flower f2"></div>
    <div class="flower f3"></div>
    <div class="flower f4"></div>
    <div class="flower f5"></div>

    <!-- Draft Yard (dark mode) — pixel graveyard, hidden until toggled -->
    <div class="yard-moon"></div>
    <div class="yard-stars"></div>
    <div class="tomb tomb-1"></div>
    <div class="tomb tomb-2"></div>
    <div class="tomb tomb-3"></div>
    <div class="yard-pumpkin">
      {pumpkinKing.flat().map(c => <div style={`background:${colorMap[c]};`} />)}
    </div>
    <div class="yard-fog"></div>
  </div>

  <!-- Name tag -->
  <div class="desktop-nametag">
    <span class="nametag-name">LYLA HUANG</span>
    <span class="nametag-desc">I spent a decade selling stuff for brands. <br> Now, I create products for people.</span>
  </div>

  <!-- Resume overlapping the sun -->
  <DesktopIcon id="resume" label="resume.pdf" icon="resume" top="8.5%" left="81%" />

  <!-- Main nav — matched from user screenshot -->
  <DesktopIcon id="about" label="about.exe" icon="terminal" top="10%" left="16%" />
  <DesktopIcon id="projects" label="projects/" icon="folder" top="28%" left="32%" />
  <DesktopIcon id="skills" label="capabilities.dll" icon="gear" top="17%" left="63%" />
  <DesktopIcon id="contact" label="contact.txt" icon="coffee" top="78%" left="90%" />

  <!-- Easter eggs — scattered sky + meadow -->
  <DesktopIcon id="films" label="films.exe" icon="film" top="46%" left="10%" />
  <DesktopIcon id="recycle" label="recycle_bin/" icon="trash" top="3%" left="92%" />
  <DesktopIcon id="todo" label="todo.md" icon="checklist" top="32%" left="90%" />
  <DesktopIcon id="readme" label="readme.txt" icon="notepad" top="58%" left="72%" />
  <!-- NO VACANCY escape-room game — desktop only, opens a redirect warning -->
  <DesktopIcon id="game" label="game.exe" icon="computer" top="72%" left="30%" />
  <!-- Message in the Wind — desktop only, a self-typing CLI that redirects -->
  <DesktopIcon id="message" label="message.sh" icon="cli" top="42%" left="53%" />
  <!-- Duck click counter + mini game icon -->
  <div class="duck-counter" id="duckCounter">
    <div class="mini-duck-btn desktop-icon" data-icon-id="duckgame">
      <div class="mini-duck-grid">
        {duckGrid.flat().map(c => <div style={`background:${colorMap[c]};`} />)}
      </div>
    </div>
    QUACK COUNT: <span id="duckCountNum">000</span>
  </div>

  <!-- Desktop pet duck — walks behind icons (z-index:3, icons are z-index:5) -->
<div class="duck walking" id="deskDuck">
  <!-- Frame 1: feet apart (stride)
       Row 1: _ _ Y Y Y _ _ _   head top
       Row 2: _ _ Y K Y O _ _   head with eye + beak
       Row 3: _ _ Y Y Y _ _ _   neck
       Row 4: Y Y Y Y Y Y _ _   body wide
       Row 5: Y Y Y Y Y Y _ _   body wide
       Row 6: _ Y Y Y Y Y _ _   body
       Row 7: _ _ Y Y Y _ _ _   tail taper
       Row 8: _ _ O _ _ O _ _   feet apart -->
  <div class="duck-frame duck-frame-1">
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#222"></div><div style="background:#FFE066"></div><div style="background:#FF6B00"></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div></div><div></div><div style="background:#FF6B00"></div><div></div><div></div><div style="background:#FF6B00"></div><div></div><div></div>
  </div>
  <!-- Frame 2: feet together (passing) -->
  <div class="duck-frame duck-frame-2">
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#222"></div><div style="background:#FFE066"></div><div style="background:#FF6B00"></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div>
    <div></div><div></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div style="background:#FFE066"></div><div></div><div></div><div></div>
    <div></div><div></div><div></div><div style="background:#FF6B00"></div><div style="background:#FF6B00"></div><div></div><div></div><div></div>
  </div>
</div>
</div>

<style is:global>
  .desktop {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* ========== PIXEL LANDSCAPE ========== */
  .landscape {
    position: absolute;
    inset: 0;
    image-rendering: pixelated;
  }

  .sky {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 65%;
    background: linear-gradient(to bottom, #87CEEB 0%, #B8E0F6 50%, #D4ECF7 100%);
  }

  .pixel-sun {
    position: absolute;
    top: 10%;
    right: 15%;
    width: 40px;
    height: 40px;
    background: #FFE066;
    box-shadow:
      0 0 0 4px #FFD700,
      0 0 0 8px rgba(255,215,0,0.3),
      0 0 40px rgba(255,215,0,0.2);
    image-rendering: pixelated;
  }

  /* Clouds — blocky pixel rectangles */
  .cloud {
    position: absolute;
    background: rgba(255,255,255,0.85);
    image-rendering: pixelated;
  }

  .cloud::before, .cloud::after {
    content: '';
    position: absolute;
    background: rgba(255,255,255,0.85);
  }

  .cloud-1 {
    top: 15%; left: 10%;
    width: 80px; height: 16px;
  }
  .cloud-1::before { width: 48px; height: 16px; top: -12px; left: 16px; }
  .cloud-1::after { width: 32px; height: 12px; top: -20px; left: 28px; }

  .cloud-2 {
    top: 22%; left: 55%;
    width: 60px; height: 12px;
  }
  .cloud-2::before { width: 36px; height: 12px; top: -10px; left: 12px; }

  .cloud-3 {
    top: 12%; left: 40%;
    width: 48px; height: 10px;
  }
  .cloud-3::before { width: 28px; height: 10px; top: -8px; left: 10px; }

  /* Rolling hills */
  .hill {
    position: absolute;
    left: 0; right: 0;
    border-radius: 50% 50% 0 0;
  }

  .hill-far {
    bottom: 30%;
    height: 20%;
    background: #7DB87D;
    opacity: 0.5;
  }

  .hill-mid {
    bottom: 28%;
    height: 18%;
    background: #6AAF6A;
    left: -10%;
    right: -10%;
    opacity: 0.7;
  }

  .hill-near {
    bottom: 25%;
    height: 15%;
    background: #5CA05C;
    left: -5%;
    right: -5%;
  }

  /* Ground */
  .ground {
    position: absolute;
    bottom: 0;
    left: 0; right: 0;
    height: 35%;
    background: linear-gradient(to bottom, #5CA05C 0%, #4A8F4A 30%, #3D7A3D 100%);
  }

  /* Pixel trees */
  .tree {
    position: absolute;
    width: 20px;
    height: 32px;
    image-rendering: pixelated;
  }

  .tree::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 8px;
    width: 4px;
    height: 12px;
    background: #8B6B3D;
  }

  .tree::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    background: #2D7A2D;
    border-radius: 2px;
  }

  .tree-1 { bottom: 34%; left: 8%; }
  .tree-2 { bottom: 36%; left: 25%; height: 40px; }
  .tree-2::after { width: 24px; height: 26px; left: -2px; }
  .tree-2::before { height: 14px; }
  .tree-3 { bottom: 33%; right: 20%; }
  .tree-4 { bottom: 35%; right: 35%; height: 36px; }
  .tree-4::after { width: 22px; height: 24px; left: -1px; background: #267326; }
  .tree-4::before { height: 12px; }

  /* Pixel flowers on the ground */
  .flower {
    position: absolute;
    width: 4px;
    height: 4px;
    image-rendering: pixelated;
  }

  .flower::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 4px;
    height: 6px;
    background: #4A8F4A;
  }

  .f1 { bottom: 30%; left: 15%; background: #FF6B00; }
  .f2 { bottom: 28%; left: 45%; background: #FFE066; }
  .f3 { bottom: 32%; right: 30%; background: #FF6B00; }
  .f4 { bottom: 26%; right: 15%; background: #FFE066; }
  .f5 { bottom: 29%; left: 60%; background: #FF6B00; }

  /* ========== DRAFT YARD (dark mode) — pixel graveyard ========== */
  /* toggle lives in the taskbar beside the clock */
  .theme-toggle {
    width: 26px; height: 20px; padding: 0; cursor: pointer; flex: none;
    background: none; border: 1px solid #444; border-radius: 3px;
    display: flex; align-items: center; justify-content: center; image-rendering: pixelated;
    transition: border-color 0.15s, background 0.15s;
  }
  .theme-toggle:hover { border-color: var(--orange); background: rgba(255,107,0,0.12); }
  /* moon/sun colored to match the taskbar — muted grey in day, orange at night */
  .tt-moon { width: 13px; height: 13px; border-radius: 50%; background: #9ba1ab; box-shadow: inset -4px -2px 0 #5a5f68; }
  .theme-toggle:hover .tt-moon { background: var(--orange); box-shadow: inset -4px -2px 0 #a8450a; }
  .tt-sun { display: none; width: 10px; height: 10px; border-radius: 50%; background: var(--orange);
    box-shadow: 0 -7px 0 -3px var(--orange), 0 7px 0 -3px var(--orange), -7px 0 0 -3px var(--orange), 7px 0 0 -3px var(--orange); }
  body.draft-yard .tt-moon { display: none; }
  body.draft-yard .tt-sun { display: block; }

  /* yard elements — hidden in the meadow */
  .yard-moon, .yard-stars, .tomb, .yard-pumpkin, .yard-fog { display: none; }

  /* square-ish pixel moon, mirroring the daytime .pixel-sun */
  .yard-moon {
    position: absolute; top: 9%; left: 13%; width: 46px; height: 46px; border-radius: 3px;
    background: #dfe8ff; image-rendering: pixelated;
    box-shadow:
      0 0 0 4px #c3d0f0,
      0 0 0 8px rgba(200,215,245,0.3),
      0 0 40px rgba(190,205,255,0.35),
      inset -8px -6px 0 #c3d0f0;
  }
  .yard-stars {
    position: absolute; left: 0; right: 0; top: 0; height: 55%; pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 22% 18%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 35% 32%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 60% 12%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 72% 26%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 85% 15%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 48% 22%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 9% 30%, #fff, transparent);
  }
  /* tombstones */
  .tomb {
    position: absolute; width: 34px; height: 40px; background: #6c6b86;
    /* stepped pixel-art headstone top (no smooth curve) */
    clip-path: polygon(
      29% 0, 71% 0,
      71% 12%, 88% 12%,
      88% 28%, 100% 28%,
      100% 100%, 0 100%,
      0 28%, 12% 28%,
      12% 12%, 29% 12%
    );
    box-shadow: inset -4px 0 0 rgba(0,0,0,0.22), inset 4px 0 0 rgba(255,255,255,0.08);
    image-rendering: pixelated;
  }
  .tomb::before {
    content: ''; position: absolute; top: 13px; left: 50%; transform: translateX(-50%);
    width: 13px; height: 3px; background: rgba(0,0,0,0.28); box-shadow: 0 5px 0 rgba(0,0,0,0.28);
  }
  .tomb-1 { bottom: 31%; left: 40%; }
  .tomb-2 { bottom: 29%; left: 58%; width: 28px; height: 32px; }
  .tomb-3 { bottom: 30%; right: 16%; width: 30px; height: 36px; }
  /* pumpkin — small, wanders the yard like the duck (left/facing set by JS) */
  .yard-pumpkin {
    position: absolute; bottom: 20%; left: 9%; z-index: 4;
    grid-template-columns: repeat(9, 5px); grid-template-rows: repeat(13, 5px);
    image-rendering: pixelated; filter: drop-shadow(0 0 7px rgba(255,120,0,0.5));
    will-change: left, bottom, transform; cursor: pointer;
  }
  body.draft-yard .yard-pumpkin:hover { filter: drop-shadow(0 0 11px rgba(255,150,40,0.9)); }
  .yard-pumpkin > div { width: 5px; height: 5px; }
  /* walk cycle — legs alternate stepping while moving (no vertical bounce) */
  .yard-pumpkin.walking > div:nth-child(111),
  .yard-pumpkin.walking > div:nth-child(112) { animation: pumpStepL 0.44s steps(1, end) infinite; }
  .yard-pumpkin.walking > div:nth-child(114),
  .yard-pumpkin.walking > div:nth-child(115) { animation: pumpStepR 0.44s steps(1, end) infinite; }
  @keyframes pumpStepL { 0%, 49.9% { transform: translateY(-2px); } 50%, 100% { transform: translateY(0); } }
  @keyframes pumpStepR { 0%, 49.9% { transform: translateY(0); } 50%, 100% { transform: translateY(-2px); } }
  /* drifting ground fog */
  .yard-fog {
    position: absolute; left: -6%; right: -6%; bottom: 16%; height: 19%; pointer-events: none;
    background: linear-gradient(to top, transparent, rgba(214,222,245,0.42) 42%, rgba(214,222,245,0.14) 74%, transparent);
    animation: yardFog 9s ease-in-out infinite alternate;
  }
  @keyframes yardFog { from { transform: translateX(-2.5%); } to { transform: translateX(2.5%); } }

  /* ===== the swap: meadow -> graveyard ===== */
  body.draft-yard .sky { background: linear-gradient(to bottom, #190f2e 0%, #3a1f5e 45%, #6a3a86 80%, #7d4a92 100%); }
  body.draft-yard .pixel-sun { display: none; }
  body.draft-yard .cloud, body.draft-yard .cloud::before, body.draft-yard .cloud::after { background: rgba(180,170,205,0.2); }
  body.draft-yard .hill-far { background: #2a2140; opacity: 0.6; }
  body.draft-yard .hill-mid { background: #241b38; opacity: 0.8; }
  body.draft-yard .hill-near { background: #1d1630; }
  body.draft-yard .ground {
    background-color: #1c1834;
    /* speckled graveyard dirt — scattered pixel flecks, no hard gradient band */
    background-image:
      radial-gradient(1.5px 1.5px at 8% 26%, rgba(210,190,250,0.5), transparent),
      radial-gradient(2.5px 2.5px at 13% 68%, rgba(255,140,40,0.75), transparent),
      radial-gradient(2.5px 2.5px at 17% 44%, rgba(90,235,90,0.7), transparent),
      radial-gradient(2.5px 2.5px at 24% 38%, rgba(255,150,50,0.65), transparent),
      radial-gradient(1.5px 1.5px at 31% 70%, rgba(210,190,250,0.4), transparent),
      radial-gradient(2.5px 2.5px at 37% 52%, rgba(90,235,90,0.6), transparent),
      radial-gradient(2.5px 2.5px at 44% 80%, rgba(255,140,40,0.6), transparent),
      radial-gradient(1.5px 1.5px at 52% 34%, rgba(210,190,250,0.4), transparent),
      radial-gradient(2.5px 2.5px at 58% 64%, rgba(90,235,90,0.62), transparent),
      radial-gradient(2.5px 2.5px at 64% 46%, rgba(255,150,50,0.66), transparent),
      radial-gradient(1.5px 1.5px at 71% 76%, rgba(210,190,250,0.4), transparent),
      radial-gradient(2.5px 2.5px at 78% 40%, rgba(90,235,90,0.6), transparent),
      radial-gradient(2.5px 2.5px at 84% 60%, rgba(255,140,40,0.66), transparent),
      radial-gradient(1.5px 1.5px at 90% 30%, rgba(210,190,250,0.4), transparent),
      radial-gradient(2.5px 2.5px at 95% 70%, rgba(90,235,90,0.58), transparent),
      linear-gradient(to bottom, #1f1b38 0%, #1a1630 100%);
  }
  body.draft-yard .tree::before { background: #0e0b18; }
  body.draft-yard .tree::after { background: #181327; }
  body.draft-yard .flower { background: #b06bd6; }
  body.draft-yard .flower::before { background: #3a2a52; }
  body.draft-yard .yard-moon, body.draft-yard .yard-stars, body.draft-yard .tomb, body.draft-yard .yard-fog { display: block; }
  body.draft-yard .yard-pumpkin { display: grid; }
  /* the duck clocks out when the yard wakes up */
  body.draft-yard #deskDuck, body.draft-yard .duck-counter { display: none !important; }

  /* ========== DESKTOP PET DUCK ========== */
  .duck {
    position: absolute;
    bottom: 34%;
    left: 200px;
    z-index: 3;
    image-rendering: pixelated;
  }

  .duck-frame {
    display: grid;
    grid-template-columns: repeat(8, 6px);
    grid-template-rows: repeat(8, 6px);
    image-rendering: pixelated;
    position: absolute;
    top: 0; left: 0;
  }
  .duck-frame div {
    width: 6px;
    height: 6px;
  }

  /* Frame toggling — JS adds/removes .frame-2 */
  .duck-frame-2 { opacity: 0; }
  .duck.frame-2 .duck-frame-1 { opacity: 0; }
  .duck.frame-2 .duck-frame-2 { opacity: 1; }

  /* Reserve space for the sprite */
  .duck { width: 48px; height: 48px; position: absolute; }

  .duck.idle .duck-frame {
    animation: duck-idle 1s steps(2) infinite;
  }

  .duck.struggling {
    cursor: grabbing;
  }
  .duck.struggling .duck-frame {
    animation: duck-struggle 0.12s steps(2) infinite;
  }

  @keyframes duck-idle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1px); }
  }

  @keyframes duck-struggle {
    0% { transform: rotate(-8deg) translateX(-2px); }
    25% { transform: rotate(6deg) translateX(2px); }
    50% { transform: rotate(-5deg) translateX(-1px); }
    75% { transform: rotate(7deg) translateX(1px); }
  }

  @keyframes duck-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes duck-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }

  @keyframes duck-peck {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @keyframes duck-land {
    0% { transform: scaleY(0.7) scaleX(1.2); }
    50% { transform: scaleY(1.1) scaleX(0.9); }
    100% { transform: scaleY(1) scaleX(1); }
  }

  @keyframes duck-sneeze {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(15px) scaleX(1.2); }
  }
  @keyframes duck-wave {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(-10deg); }
  }
  @keyframes duck-dizzy {
    to { transform: rotate(1080deg); }
  }
  @keyframes duck-angry {
    0% { transform: translate(-1px, -1px); }
    100% { transform: translate(1px, 1px); }
  }

  /* Duck click counter */
  .duck-counter {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 7;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: #888;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mini-duck-btn {
    position: static;
    pointer-events: auto;
    cursor: pointer;
    padding: 2px;
    z-index: 7;
  }
  .mini-duck-btn:hover { transform: scale(1.1); }

  .mini-duck-grid {
    width: 20px;
    height: 20px;
    display: grid;
    grid-template-columns: repeat(10, 2px);
    grid-template-rows: repeat(10, 2px);
    image-rendering: pixelated;
  }
  .mini-duck-grid div {
    width: 2px;
    height: 2px;
  }

  /* Name tag — small, bottom-left */
  .desktop-nametag {
    position: absolute;
    bottom: 80px;
    left: 16px;
    z-index: 3;
  }

  .nametag-name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    display: block;
    letter-spacing: 0.05em;
  }

  .nametag-desc {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-shadow: 1px 1px 2px rgba(0,0,0,0.4);
    max-width: 320px;
    line-height: 1.5;
    margin-top: 0.4rem;
  }


  /* Icon labels — white with shadow for sky readability */
  .desktop-icon-label {
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.6);
  }

  @media (max-width: 768px) {
    .desktop-icon { display: none !important; }
    .desktop-nametag { display: none !important; }
    .duck-counter { display: none !important; }
    #deskDuck { display: none !important; }
    .theme-toggle { display: none !important; }
    .sky { height: 80%; }
  }
</style>

<script>
  (function () {
    const body = document.body;
    const btn = document.getElementById('themeToggle');
    const KEY = 'draftYard';
    const mobile = window.matchMedia('(max-width: 768px)');
    const wanted = () => { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
    // Dark mode is desktop-only — never apply the Draft Yard on mobile.
    const sync = () => body.classList.toggle('draft-yard', wanted() && !mobile.matches);
    sync();
    mobile.addEventListener('change', sync);
    if (btn) btn.addEventListener('click', () => {
      const on = !body.classList.contains('draft-yard');
      try { localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) {}
      sync();
    });
  })();

  // The pumpkin waddles around the yard like the desktop duck does the meadow.
  (function () {
    const p = document.querySelector('.yard-pumpkin');
    if (!p) return;
    const MIN = 6, MAX = 82, BASE = 19; // percent of the desktop
    let x = 9, dir = 1, target = 60, pause = 600, last = performance.now();
    const pick = () => {
      target = MIN + Math.random() * (MAX - MIN);
      dir = target >= x ? 1 : -1;
      pause = 500 + Math.random() * 1400;
    };
    const frame = (now) => {
      const dt = Math.min(now - last, 50); last = now;
      if (document.body.classList.contains('draft-yard')) {
        p.style.bottom = BASE + '%';
        if (pause > 0) {
          pause -= dt;
          p.classList.remove('walking');
        } else {
          x += dir * 0.006 * dt;
          if ((dir > 0 && x >= target) || (dir < 0 && x <= target)) { x = target; pick(); }
          p.classList.add('walking');
          p.style.left = x + '%';
        }
        p.style.transform = 'scaleX(' + dir + ')';
      }
      requestAnimationFrame(frame);
    };
    pick();
    requestAnimationFrame(frame);
  })();
</script>
