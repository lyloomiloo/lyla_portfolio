  .bulb:nth-child(4n+1) { background: #ff5d5d; box-shadow: 0 0 9px 2px rgba(255,93,93,0.75); }
  .bulb:nth-child(4n+2) { background: #ffd24a; box-shadow: 0 0 9px 2px rgba(255,210,74,0.75); }
