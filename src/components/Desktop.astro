  /* the duck clocks out in winter too */
  body.snow-yard #deskDuck, body.snow-yard .duck-counter { display: none !important; }

  /* snowman — hops around the snow like the pumpkin wanders the yard (left/facing set by JS) */
  .yard-snowman {
