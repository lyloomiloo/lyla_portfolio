---
import { getCollection } from 'astro:content';
import { icons, colorMap } from '../data/pixel-icons';

interface Props { slug: string; iconKey: string; iconBg: string; }
const { slug, iconKey, iconBg } = Astro.props;

const project = (await getCollection('projects')).find(p => p.data.slug === slug);
const d = project!.data;
const tagline = d.hook.includes('|') ? d.hook.split('|')[0] : d.tagline;
const body = d.hook.includes('|') ? d.hook.split('|')[1] : d.hook;
const grid = icons[iconKey] || icons['notepad'];
const stack = (d.tags || []).join(' · ');
const getLabel = d.download ? 'GET' : 'VISIT';
---

<div class="appstore">
  <div class="appstore-head">
    <div class="appstore-icon appstore-icon--pixel" style={`background:${iconBg}`}>
      <div class="appstore-icon-pixels">
        {grid.flat().map(c => <div style={`background:${colorMap[c]};`} />)}
      </div>
    </div>
    <div class="appstore-head-text">
      <div class="appstore-title">{d.displayTitle}</div>
      <div class="appstore-sub">{tagline}</div>
    </div>
    {d.link && (
      <a
        href={d.link}
        target={d.download ? undefined : '_blank'}
        rel="noopener"
        download={d.download ? '' : undefined}
        class="appstore-get"
      >{getLabel}</a>
    )}
  </div>

  {body && <div class="appstore-desc">{body}</div>}

  {d.video && (
    <div class="appstore-screenshots">
      <div class="appstore-screenshot" data-gallery-open>
        <video data-lazy-src={d.video} poster={d.thumbnail} autoplay loop muted playsinline preload="none"></video>
      </div>
      {d.thumbnail && (
        <div class="appstore-screenshot" data-gallery-open>
          <img src={d.thumbnail} alt={d.displayTitle} />
        </div>
      )}
    </div>
  )}

  <div class="appstore-section">Information</div>
  <div class="appstore-info">
    {d.type && <div class="appstore-row"><span class="appstore-key">Location</span><span>{d.type}</span></div>}
    {stack && <div class="appstore-row"><span class="appstore-key">Made with</span><span>{stack}</span></div>}
    <div class="appstore-row last"><span class="appstore-key">Status</span><span>{d.status}</span></div>
  </div>

  {d.download && d.link && (
    <div class="appstore-bottom-btns">
      <a href={d.link} download class="appstore-bottom-btn">{d.cta ?? 'DOWNLOAD ↓'}</a>
    </div>
  )}
</div>

<style is:global>
  /* Pixel-art icon inside the app-store header (fun projects) */
  .appstore-icon--pixel {
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; padding: 0;
  }
  .appstore-icon-pixels {
    width: 40px; height: 40px;
    display: grid; grid-template-columns: repeat(10, 1fr); grid-template-rows: repeat(10, 1fr);
    image-rendering: pixelated;
  }
  .appstore-icon-pixels > div { width: 100%; height: 100%; }
</style>
