---
import { getCollection } from 'astro:content';

interface Props { slug: string; iconBg: string; abbr: string; iconFg?: string; }
const { slug, iconBg, abbr, iconFg = '#FFFFFF' } = Astro.props;

const project = (await getCollection('projects')).find(p => p.data.slug === slug);
const d = project!.data;
const subhead = d.hook.includes('|') ? d.hook.split('|')[0] : d.tagline;
const story = d.description || (d.hook.includes('|') ? d.hook.split('|')[1] : d.hook);
const stack = d.stack || (d.tags || []).join(' · ');
const getLabel = d.download ? 'GET' : 'VISIT';
---

<div class="appstore">
  <div class="appstore-head">
    <div class="appstore-icon appstore-icon--abbr" style={`background:${iconBg};color:${iconFg}`}>{abbr}</div>
    <div class="appstore-head-text">
      <div class="appstore-title">{d.displayTitle}</div>
      <div class="appstore-sub">{subhead}</div>
    </div>
    {d.link && (
      <a
        href={d.link}
        target={d.download ? undefined : '_blank'}
        rel="noopener"
        download={d.download ? '' : undefined}
        class="appstore-get"
      >{getLabel}</a>
    )}
  </div>

  {story && <div class="appstore-desc">{story}</div>}

  {d.video && (
    <div class="appstore-screenshots">
      <div class="appstore-screenshot" data-gallery-open>
        <video data-lazy-src={d.video} poster={d.thumbnail} autoplay loop muted playsinline preload="none"></video>
      </div>
      {d.thumbnail && (
        <div class="appstore-screenshot" data-gallery-open>
          <img src={d.thumbnail} alt={d.displayTitle} />
        </div>
      )}
    </div>
  )}

  <div class="appstore-section">Information</div>
  <div class="appstore-info">
    {d.type && <div class="appstore-row"><span class="appstore-key">Type</span><span>{d.type}</span></div>}
    {stack && <div class="appstore-row"><span class="appstore-key">Stack</span><span>{stack}</span></div>}
    {d.location && <div class="appstore-row"><span class="appstore-key">Location</span><span>{d.location}</span></div>}
    <div class="appstore-row last"><span class="appstore-key">Status</span><span>{d.status}</span></div>
  </div>

  {d.download && d.link && (
    <div class="appstore-bottom-btns">
      <a href={d.link} download class="appstore-bottom-btn">{d.cta ?? 'DOWNLOAD ↓'}</a>
    </div>
  )}
</div>

<style is:global>
  /* Simple abbreviation icon inside the app-store header (fun projects) */
  .appstore-icon--abbr {
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.9rem; font-weight: 700; letter-spacing: 0.05em;
  }
</style>
