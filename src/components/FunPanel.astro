---
import { getCollection } from 'astro:content';
import { icons, colorMap } from '../data/pixel-icons';

interface Props { slug: string; iconKey: string; iconBg: string; }
const { slug, iconKey, iconBg } = Astro.props;

const project = (await getCollection('projects')).find(p => p.data.slug === slug);
const d = project!.data;
const tagline = d.hook.includes('|') ? d.hook.split('|')[0] : d.tagline;
const body = d.hook.includes('|') ? d.hook.split('|')[1] : d.hook;
const grid = icons[iconKey] || icons['notepad'];
---

<div class="fun">
  <div class="fun-hero">
    <div class="fun-icon" style={`background:${iconBg}`}>
      <div class="fun-icon-pixels">
        {grid.flat().map(c => <div style={`background:${colorMap[c]};`} />)}
      </div>
    </div>
    <div class="fun-hero-text">
      <h2 class="fun-title">{d.displayTitle}</h2>
      <p class="fun-tagline">{tagline}</p>
      <div class="fun-meta">{d.type} &middot; {d.status}</div>
    </div>
  </div>

  {d.video && (
    <div class="fun-media" data-gallery-open>
      <video src={d.video} poster={d.thumbnail} muted loop playsinline preload="none"></video>
      <span class="fun-play">&#9654;</span>
      <span class="fun-expand">&#10530;</span>
    </div>
  )}

  {body && <p class="fun-desc">{body}</p>}

  {d.link && (
    <a
      class="fun-cta"
      href={d.link}
      target={d.download ? undefined : '_blank'}
      rel="noopener"
      download={d.download ? '' : undefined}
    >{d.cta ?? 'VISIT SITE →'}</a>
  )}
</div>

<style is:global>
  .fun { padding: 4px 2px 48px; }
  .fun-hero { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .fun-icon {
    width: 62px; height: 62px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .fun-icon-pixels {
    width: 44px; height: 44px;
    display: grid; grid-template-columns: repeat(10, 1fr); grid-template-rows: repeat(10, 1fr);
    image-rendering: pixelated;
  }
  .fun-icon-pixels > div { width: 100%; height: 100%; }
  .fun-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
  .fun-tagline { font-family: var(--font-body); font-size: 0.85rem; color: var(--text-mid); margin-top: 3px; }
  .fun-meta { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim); margin-top: 5px; }

  .fun-media {
    position: relative; border: 1px solid var(--border); background: #000;
    overflow: hidden; cursor: pointer;
  }
  .fun-media video, .fun-media img { width: 100%; display: block; }
  .fun-play {
    position: absolute; inset: 0; margin: auto;
    width: 46px; height: 46px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; color: #fff;
    background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.5);
  }
  .fun-expand {
    position: absolute; top: 8px; right: 8px;
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; color: #fff;
    background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.35);
  }

  .fun-desc { font-family: var(--font-body); font-size: 0.95rem; line-height: 1.6; color: var(--text); margin: 18px 0; }
  .fun-cta {
    display: inline-block;
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700;
    color: #fff; background: var(--orange);
    padding: 12px 20px; text-decoration: none;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .fun-cta:active { transform: translateY(1px); }
</style>
